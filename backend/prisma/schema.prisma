// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SexoBiologico {
  MASCULINO
  FEMENINO
}

enum ResultadoAdmision {
  ADMITIDO
  DIFERIDO
}

enum TipoDiferimiento {
  TEMPORAL
  PERMANENTE
}

model Donante {
  id              Int           @id @default(autoincrement())
  nombre          String
  apellido        String
  dni             String        @unique
  fechaNacimiento DateTime      @db.Date
  lugarNacimiento String
  sexoBiologico   SexoBiologico
  domicilio       String
  codigoPostal    String
  email           String
  telefonoFijo    String?
  telefonoCelular String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  donaciones      Donacion[]
  entrevistas     EntrevistaPreDonacion[]

  @@map("donantes")
}

model Donacion {
  id         Int                     @id @default(autoincrement())
  donanteId  Int
  donante    Donante                 @relation(fields: [donanteId], references: [id])
  entrevista EntrevistaPreDonacion?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@map("donaciones")
}

model EntrevistaPreDonacion {
  id                Int               @id @default(autoincrement())
  donanteId         Int
  donacionId        Int?              @unique
  resultadoAdmision ResultadoAdmision
  tipoDiferimiento  TipoDiferimiento?
  causaDiferimiento String?
  entrevistador     String?
  donante           Donante           @relation(fields: [donanteId], references: [id])
  donacion          Donacion?         @relation(fields: [donacionId], references: [id])
  respuestas        Json
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("entrevistas_pre_donacion")
}
