generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ===============================
// Enums existentes (app)
// ===============================

enum SexoBiologico {
  MASCULINO
  FEMENINO
}

enum EstadoDonacion {
  REGISTRADA
  EN_CALIFICACION
  CALIFICADA
  RECHAZADA
}

enum ResultadoAdmision {
  ADMITIDO
  DIFERIDO
}

enum TipoDiferimiento {
  TEMPORAL
  PERMANENTE
}

enum EstadoCalificacionBiologica {
  INICIADA
}

enum ResultadoAnticuerpoIrregular {
  POSITIVO
  NEGATIVO
}

enum GrupoSanguineoABO {
  A
  B
  AB
  O
}

enum FactorRhD {
  POSITIVO
  NEGATIVO
}

enum TipoHemocomponente {
  GLOBULOS_ROJOS
  PLASMA
  PLAQUETAS
  CRIOPRECIPITADO
}

enum EstadoSolicitudTransfusion {
  PENDIENTE
  APROBADA
  CANCELADA
}

enum EstadoUnidadSangre {
  DISPONIBLE
  RESERVADA
  BLOQUEADA
  VENCIDA
  DADA_DE_BAJA
}

enum EstadoUnidad {
  PENDIENTE
  LIBERADA
  BLOQUEADA
}

enum TipoMuestraSerologia {
  PRIMERA
  SEGUNDA
}

enum RolUsuario {
  ADMINISTRADOR
  TECNICO_HEMOTERAPIA
  CONSULTA_MATERNIDAD
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

// ==========================================
// MÓDULO DE PERSONAS Y UBICACIÓN (DER)
// ==========================================

model Provincia {
  id     Int    @id @default(autoincrement())
  nombre String

  ciudades Ciudad[]

  @@map("provincias")
}

model Ciudad {
  id           Int       @id @default(autoincrement())
  nombre       String
  codigoPostal String?   @map("codigo_postal")
  idProvincia  Int       @map("id_provincia")
  provincia    Provincia @relation(fields: [idProvincia], references: [id])

  domicilios Domicilio[]

  @@index([idProvincia])
  @@map("ciudades")
}

model Domicilio {
  id           Int     @id @default(autoincrement())
  calle        String?
  numero       String?
  piso         String?
  departamento String?
  idCiudad     Int     @map("id_ciudad")
  ciudad       Ciudad  @relation(fields: [idCiudad], references: [id])

  personas Persona[]

  @@index([idCiudad])
  @@map("domicilios")
}

model Gyf {
  id     Int     @id @default(autoincrement())
  grupo  String?
  factor String?

  personas                      Persona[]
  estudiosInmunohematologicosRn EstudioInmunohematologicoRn[]
  transfusiones                 Transfusion[]

  @@map("gyf")
}

model Persona {
  id              Int             @id @default(autoincrement())
  dni             String?         @unique
  historiaClinica String?         @unique @map("historia_clinica")
  nombre          String?
  apellido        String?
  telefono        String?
  fechaNacimiento DateTime?       @map("fecha_nacimiento") @db.Date
  lugarNacimiento String?         @map("lugar_nacimiento")
  sexoBiologico   SexoBiologico?  @map("sexo_biologico")
  idDireccion     Int?            @map("id_direccion")
  direccion       Domicilio?      @relation(fields: [idDireccion], references: [id])
  idGrupoFactor   Int?            @map("id_grupo_factor")
  grupoFactor     Gyf?            @relation(fields: [idGrupoFactor], references: [id])

  donaciones           DonacionDer[]
  estudiosGestante     EstudioInmunohematologicoGestante[] @relation("PersonaGestante")
  estudiosRnComoMadre  EstudioInmunohematologicoRn[]       @relation("PersonaMadreRn")
  sangriasTerapeuticas SangriaTerapeutica[]
  transfusiones        Transfusion[]

  @@index([idDireccion])
  @@index([idGrupoFactor])
  @@map("personas")
}

// ==========================================
// MÓDULO DE DONACIONES Y SEROLOGÍA (DER)
// ==========================================

model DonacionDer {
  id              Int       @id @default(autoincrement())
  peso            Float?
  tensionArterial String?   @map("tension_arterial")
  hemoglobina     Float?
  fecha           DateTime? @db.Date
  voluntario      Boolean?
  reposicion      Boolean?
  autoexcluido    Boolean?
  observaciones   String?
  operador        String?
  idPersona       Int?      @map("id_persona")
  persona         Persona?  @relation(fields: [idPersona], references: [id])

  serologiaDonaciones SerologiaDonacionDer[]
  pciDonaciones       PciDonacionDer[]

  @@index([idPersona])
  @@map("donaciones_der")
}

model Serologia {
  id            Int                   @id @default(autoincrement())
  fecha         DateTime              @db.Date
  hora          DateTime              @db.Time
  tipoMuestra   TipoMuestraSerologia? @map("tipo_muestra")
  operador      String?
  observaciones String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  resultados    SerologiaResultado[]
  donaciones    SerologiaDonacion[]
  donacionesDer SerologiaDonacionDer[]

  @@map("serologias")
}

model SerologiaDonacionDer {
  id          Int         @id @default(autoincrement())
  idSerologia Int         @map("id_serologia")
  serologia   Serologia   @relation(fields: [idSerologia], references: [id])
  idDonacion  Int         @map("id_donacion")
  donacion    DonacionDer @relation(fields: [idDonacion], references: [id])

  @@index([idSerologia])
  @@index([idDonacion])
  @@map("serologia_donaciones_der")
}

model DeterminacionSerologica {
  id         Int                  @id @default(autoincrement())
  nombre     String               @unique
  resultados SerologiaResultado[]

  @@map("determinaciones_serologicas")
}

model SerologiaResultado {
  id                        Int                     @id @default(autoincrement())
  serologiaId               Int
  serologia                 Serologia               @relation(fields: [serologiaId], references: [id])
  determinacionSerologicaId Int
  determinacionSerologica   DeterminacionSerologica @relation(fields: [determinacionSerologicaId], references: [id])
  resultado                 String
  valor                     String?
  unidad                    String?
  observacion               String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@unique([serologiaId, determinacionSerologicaId])
  @@map("serologia_resultados")
}

// ==========================================
// MÓDULO DE INMUNOHEMATOLOGÍA (PCI / PCD) (DER)
// ==========================================

model Pci {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @db.Date
  hora          DateTime @db.Time
  operador      String?
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resultados        PciResultado[]
  donaciones        PciDonacion[]
  donacionesDer     PciDonacionDer[]
  estudiosGestantes PciInmunohematologicoGestante[]
  estudiosRn        EstudioInmunohematologicoRn[]

  @@map("pci")
}

model PciDonacionDer {
  id         Int         @id @default(autoincrement())
  idPci      Int         @map("id_pci")
  pci        Pci         @relation(fields: [idPci], references: [id])
  idDonacion Int         @map("id_donacion")
  donacion   DonacionDer @relation(fields: [idDonacion], references: [id])

  @@index([idPci])
  @@index([idDonacion])
  @@map("pci_donaciones_der")
}

model Antigeno {
  id         Int            @id @default(autoincrement())
  nombre     String         @unique
  resultados PciResultado[]

  @@map("antigenos")
}

model PciResultado {
  id          Int      @id @default(autoincrement())
  pciId       Int
  pci         Pci      @relation(fields: [pciId], references: [id])
  antigenoId  Int
  antigeno    Antigeno @relation(fields: [antigenoId], references: [id])
  resultado   String
  intensidad  String?
  observacion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([pciId, antigenoId])
  @@map("pci_resultados")
}

model Pcd {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @db.Date
  hora          DateTime @db.Time
  operador      String?
  observaciones String?

  resultados PcdResultado[]
  estudiosRn EstudioInmunohematologicoRn[]

  @@map("pcd")
}

model DeterminacionPcd {
  id         Int            @id @default(autoincrement())
  nombre     String         @unique
  resultados PcdResultado[]

  @@map("determinaciones_pcd")
}

model PcdResultado {
  id                 Int               @id @default(autoincrement())
  resultado          String?
  valor              String?
  unidad             String?
  observacion        String?
  idPcd              Int               @map("id_pcd")
  pcd                Pcd               @relation(fields: [idPcd], references: [id])
  idDeterminacionPcd Int?              @map("id_determinacion_pcd")
  determinacionPcd   DeterminacionPcd? @relation(fields: [idDeterminacionPcd], references: [id])

  @@index([idPcd])
  @@index([idDeterminacionPcd])
  @@map("pcd_resultados")
}

// ==========================================
// MÓDULO GESTANTES Y RECIÉN NACIDOS (DER)
// ==========================================

model EstudioInmunohematologicoGestante {
  id        Int       @id @default(autoincrement())
  numero    String?
  fecha     DateTime? @db.Date
  operador  String?
  idPersona Int       @map("id_persona")
  gestante  Persona   @relation("PersonaGestante", fields: [idPersona], references: [id])

  pciAsociados PciInmunohematologicoGestante[]

  @@index([idPersona])
  @@map("estudios_inmunohematologicos_gestantes")
}

model PciInmunohematologicoGestante {
  id                                    Int                               @id @default(autoincrement())
  idPci                                 Int                               @map("id_pci")
  pci                                   Pci                               @relation(fields: [idPci], references: [id])
  idEstudiosInmunohematologicosGestante Int                               @map("id_estudios_inmunohematologicos_gestantes")
  estudioGestante                       EstudioInmunohematologicoGestante @relation(fields: [idEstudiosInmunohematologicosGestante], references: [id])

  @@index([idPci])
  @@index([idEstudiosInmunohematologicosGestante])
  @@map("pci_inmunohematologicos_gestantes")
}

model EstudioInmunohematologicoRn {
  id            Int       @id @default(autoincrement())
  numero        String?
  fecha         DateTime? @db.Date
  rn            String?
  dni           String?
  idMadre       Int?      @map("id_madre")
  madre         Persona?  @relation("PersonaMadreRn", fields: [idMadre], references: [id])
  idGrupoFactor Int?      @map("id_grupo_factor")
  grupoFactor   Gyf?      @relation(fields: [idGrupoFactor], references: [id])
  ipAntiD       String?   @map("IP_anti_D")
  idPcd         Int?      @map("id_pcd")
  pcd           Pcd?      @relation(fields: [idPcd], references: [id])
  idPci         Int?      @map("id_pci")
  pci           Pci?      @relation(fields: [idPci], references: [id])
  operador      String?
  observaciones String?

  @@index([idMadre])
  @@index([idGrupoFactor])
  @@index([idPcd])
  @@index([idPci])
  @@map("estudios_inmunohematologicos_rn")
}

// ==========================================
// MÓDULO SANGRÍAS TERAPÉUTICAS Y TRANSFUSIONES (DER)
// ==========================================

model ObraSocial {
  id     Int     @id @default(autoincrement())
  nombre String?

  sangrias SangriaTerapeutica[]

  @@map("obra_social")
}

model Medico {
  id     Int     @id @default(autoincrement())
  nombre String?

  sangrias SangriaTerapeutica[]

  @@map("medicos")
}

model SangriaTerapeutica {
  id           Int         @id @default(autoincrement())
  diagnostico  String?
  extraccion   String?
  reposicion   String?
  fecha        DateTime?   @db.Date
  tecnico      String?
  idPersona    Int?        @map("id_persona")
  persona      Persona?    @relation(fields: [idPersona], references: [id])
  idObraSocial Int?        @map("id_obra_social")
  obraSocial   ObraSocial? @relation(fields: [idObraSocial], references: [id])
  idMedico     Int?        @map("id_medico")
  medico       Medico?     @relation(fields: [idMedico], references: [id])

  @@index([idPersona])
  @@index([idObraSocial])
  @@index([idMedico])
  @@map("sangrias_terapeuticas")
}

model Fenotipo {
  id     Int     @id @default(autoincrement())
  nombre String?

  transfusionesComoFenotipo1 Transfusion[] @relation("Fenotipo1")
  transfusionesComoFenotipo2 Transfusion[] @relation("Fenotipo2")

  @@map("fenotipos")
}

model TipoTransfusion {
  id     Int     @id @default(autoincrement())
  nombre String?

  transfusiones Transfusion[]

  @@map("tipo_transfusion")
}

model Transfusion {
  id                Int              @id @default(autoincrement())
  numeroOLote       String?          @map("numero_o_lote")
  rt                String?          @map("RT")
  tolerancia        String?
  pci               String?
  pcd               String?
  anticuerpo        String?
  fecha             DateTime?        @db.Date
  tecnico           String?
  idPersona         Int?             @map("id_persona")
  persona           Persona?         @relation(fields: [idPersona], references: [id])
  idFenotipo1       Int?             @map("id_fenotipo_1")
  fenotipo1         Fenotipo?        @relation("Fenotipo1", fields: [idFenotipo1], references: [id])
  idGrupoFactor     Int?             @map("id_grupo_factor")
  grupoFactor       Gyf?             @relation(fields: [idGrupoFactor], references: [id])
  idFenotipo2       Int?             @map("id_fenotipo_2")
  fenotipo2         Fenotipo?        @relation("Fenotipo2", fields: [idFenotipo2], references: [id])
  idTipoTransfusion Int?             @map("id_tipo_transfusion")
  tipoTransfusion   TipoTransfusion? @relation(fields: [idTipoTransfusion], references: [id])

  @@index([idFenotipo1])
  @@index([idGrupoFactor])
  @@index([idFenotipo2])
  @@index([idTipoTransfusion])
  @@map("transfusiones")
}

// ==========================================
// MODELOS EXISTENTES DE LA APLICACIÓN
// (conservados para compatibilidad)
// ==========================================

model Donante {
  id              Int           @id @default(autoincrement())
  nombre          String
  apellido        String
  dni             String        @unique
  fechaNacimiento DateTime      @db.Date
  lugarNacimiento String
  sexoBiologico   SexoBiologico
  domicilio       String
  codigoPostal    String
  email           String
  telefonoFijo    String?
  telefonoCelular String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  donaciones  Donacion[]
  entrevistas EntrevistaPreDonacion[]

  @@map("donantes")
}

model Paciente {
  id              Int      @id @default(autoincrement())
  nombre          String
  apellido        String
  dni             String   @unique
  fechaNacimiento DateTime @db.Date
  operador        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  solicitudesTransfusion SolicitudTransfusion[]

  @@map("pacientes")
}

model Donacion {
  id              Int            @id @default(autoincrement())
  donanteId       Int
  donante         Donante        @relation(fields: [donanteId], references: [id])
  fechaHora       DateTime       @default(now())
  operador        String
  estado          EstadoDonacion @default(REGISTRADA)
  peso            String?
  tensionArterial String?
  hemoglobina     String?
  voluntario      Boolean        @default(false)
  reposicion      Boolean        @default(false)
  autoExcluido    Boolean        @default(false)
  observaciones   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  pciDonaciones            PciDonacion[]
  serologiaDonaciones      SerologiaDonacion[]
  entrevista               EntrevistaPreDonacion?
  calificacionBiologica    CalificacionBiologica?
  anticuerpoIrregular      AnticuerpoIrregular?
  estadoUnidad             EstadoUnidad            @default(PENDIENTE)
  discrepanciaResuelta     Boolean                 @default(false)
  observacionDiscrepancia  String?
  tipificacionesSanguineas TipificacionSanguinea[]
  eventosEstadoUnidad      EventoEstadoUnidad[]

  @@map("donaciones")
}

model PciDonacion {
  pciId      Int
  pci        Pci      @relation(fields: [pciId], references: [id])
  donacionId Int
  donacion   Donacion @relation(fields: [donacionId], references: [id])

  @@id([pciId, donacionId])
  @@map("pci_donaciones")
}

model SerologiaDonacion {
  serologiaId Int
  serologia   Serologia @relation(fields: [serologiaId], references: [id])
  donacionId  Int
  donacion    Donacion  @relation(fields: [donacionId], references: [id])

  @@id([serologiaId, donacionId])
  @@map("serologia_donaciones")
}

model EntrevistaPreDonacion {
  id                Int               @id @default(autoincrement())
  donanteId         Int
  donacionId        Int?              @unique
  resultadoAdmision ResultadoAdmision
  tipoDiferimiento  TipoDiferimiento?
  causaDiferimiento String?
  entrevistador     String?
  donante           Donante           @relation(fields: [donanteId], references: [id])
  donacion          Donacion?         @relation(fields: [donacionId], references: [id])
  respuestas        Json
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("entrevistas_pre_donacion")
}

model CalificacionBiologica {
  id          Int                         @id @default(autoincrement())
  donacionId  Int                         @unique
  donacion    Donacion                    @relation(fields: [donacionId], references: [id])
  estado      EstadoCalificacionBiologica @default(INICIADA)
  operador    String
  fechaInicio DateTime                    @default(now())
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@map("calificaciones_biologicas")
}

model AnticuerpoIrregular {
  id          Int                          @id @default(autoincrement())
  donacionId  Int                          @unique
  donacion    Donacion                     @relation(fields: [donacionId], references: [id])
  resultado   ResultadoAnticuerpoIrregular
  operador    String
  fechaHora   DateTime                     @default(now())
  observacion String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([donacionId, fechaHora])
  @@map("anticuerpos_irregulares")
}

model TipificacionSanguinea {
  id         Int               @id @default(autoincrement())
  donacionId Int
  donacion   Donacion          @relation(fields: [donacionId], references: [id])
  grupoABO   GrupoSanguineoABO
  factorRhD  FactorRhD
  operador   String
  fechaHora  DateTime          @default(now())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([donacionId, fechaHora])
  @@map("tipificaciones_sanguineas")
}

model SolicitudTransfusion {
  id                 Int                        @id @default(autoincrement())
  pacienteId         Int?
  paciente           Paciente?                  @relation(fields: [pacienteId], references: [id], onDelete: SetNull)
  dniPaciente        String
  nombrePaciente     String
  grupoABO           GrupoSanguineoABO
  factorRhD          FactorRhD
  tipoHemocomponente TipoHemocomponente
  cantidad           Int                        @default(1)
  estado             EstadoSolicitudTransfusion @default(PENDIENTE)
  observaciones      String?
  operador           String
  fechaHora          DateTime                   @default(now())
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  unidades UnidadSangre[]

  @@index([estado, fechaHora])
  @@index([pacienteId])
  @@map("solicitudes_transfusion")
}

model UnidadSangre {
  id                 Int                   @id @default(autoincrement())
  numeroUnidad       String                @unique
  tipoHemocomponente TipoHemocomponente
  grupoABO           GrupoSanguineoABO
  factorRhD          FactorRhD
  fechaVencimiento   DateTime              @db.Date
  estado             EstadoUnidadSangre    @default(DISPONIBLE)
  operador           String                @default("")
  fechaRecepcion     DateTime              @default(now())
  solicitudId        Int?
  solicitud          SolicitudTransfusion? @relation(fields: [solicitudId], references: [id])
  reservadaPor       String?
  reservadaEn        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([estado, fechaVencimiento])
  @@map("unidades_sangre")
}

// ==========================================
// MÓDULO DE SEGURIDAD Y TRAZABILIDAD
// ==========================================

model Usuario {
  id           Int           @id @default(autoincrement())
  nombre       String
  apellido     String
  usuario      String        @unique
  passwordHash String        @map("password_hash")
  rol          RolUsuario    @default(TECNICO_HEMOTERAPIA)
  estado       EstadoUsuario @default(ACTIVO)
  ultimoAcceso DateTime?     @map("ultimo_acceso")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("usuarios")
}

model Auditoria {
  id        Int      @id @default(autoincrement())
  fechaHora DateTime @default(now()) @map("fecha_hora")
  idUsuario Int?     @map("id_usuario")
  usuario   String?
  accion    String
  entidad   String
  entidadId String?  @map("entidad_id")
  detalle   String?
  metodo    String?
  ruta      String?
  ip        String?

  @@index([fechaHora])
  @@index([usuario])
  @@index([entidad])
  @@map("auditoria")
}

model EventoEstadoUnidad {
  id                      Int          @id @default(autoincrement())
  donacionId              Int
  donacion                Donacion     @relation(fields: [donacionId], references: [id])
  estado                  EstadoUnidad
  motivo                  String?
  usuario                 String
  discrepanciaResuelta    Boolean      @default(false)
  observacionDiscrepancia String?
  fechaHora               DateTime     @default(now())
  createdAt               DateTime     @default(now())

  @@index([donacionId, fechaHora])
  @@map("eventos_estado_unidad")
}
