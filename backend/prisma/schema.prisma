generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SexoBiologico {
  MASCULINO
  FEMENINO
}

enum EstadoDonacion {
  REGISTRADA
  EN_CALIFICACION
  CALIFICADA
  RECHAZADA
}

enum ResultadoAdmision {
  ADMITIDO
  DIFERIDO
}

enum TipoDiferimiento {
  TEMPORAL
  PERMANENTE
}

enum EstadoCalificacionBiologica {
  INICIADA
}

enum ResultadoAnticuerpoIrregular {
  POSITIVO
  NEGATIVO
}

enum GrupoSanguineoABO {
  A
  B
  AB
  O
}

enum FactorRhD {
  POSITIVO
  NEGATIVO
}

enum TipoHemocomponente {
  GLOBULOS_ROJOS
  PLASMA
  PLAQUETAS
  CRIOPRECIPITADO
}

enum EstadoSolicitudTransfusion {
  PENDIENTE
  APROBADA
  CANCELADA
}

enum ModalidadTransfusion {
  INTERNACION
  AMBULATORIA
  DOMICILIARIA
}

enum CaracterTransfusion {
  PROGRAMADA
  NO_URGENTE
  RESERVA
  URGENTE
  EMERGENCIA
}

enum AntecedenteTransfusional {
  SI
  NO
  IGNORADO
}

enum EstadoUnidadSangre {
  DISPONIBLE
  RESERVADA
  EMITIDA
  BLOQUEADA
  VENCIDA
  DADA_DE_BAJA
}

enum EstadoUnidad {
  PENDIENTE
  LIBERADA
  BLOQUEADA
}

enum MotivoBajaUnidad {
  VENCIDA
  TRANSFUNDIDA
  DESCARTADA
}

enum TipoEstudioPretransfusional {
  TIPIFICACION_ABO_RHD
  DETECCION_ANTICUERPOS
  PRUEBA_CRUZADA
}

enum ResultadoCompatibilidadPretransfusional {
  COMPATIBLE
  INCOMPATIBLE
}


model Donante {
  id              Int           @id @default(autoincrement())
  nombre          String
  apellido        String
  dni             String        @unique
  fechaNacimiento DateTime      @db.Date
  lugarNacimiento String
  sexoBiologico   SexoBiologico
  domicilio       String
  codigoPostal    String
  email           String
  telefonoFijo    String?
  telefonoCelular String
  activo          Boolean       @default(true)
  operadorModificacion String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  donaciones  Donacion[]
  entrevistas EntrevistaPreDonacion[]

  @@map("donantes")
}

model Paciente {
  id              Int      @id @default(autoincrement())
  nombre          String
  apellido        String
  dni             String   @unique
  fechaNacimiento DateTime @db.Date
  operador        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  solicitudesTransfusion SolicitudTransfusion[]

  @@map("pacientes")
}

model Donacion {
  id              Int            @id @default(autoincrement())
  donanteId       Int
  donante         Donante        @relation(fields: [donanteId], references: [id])
  fechaHora       DateTime       @default(now())
  operador        String
  estado          EstadoDonacion @default(REGISTRADA)
  peso            String?
  tensionArterial String?
  hemoglobina     String?
  voluntario      Boolean        @default(false)
  reposicion      Boolean        @default(false)
  autoExcluido    Boolean        @default(false)
  observaciones   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  pciDonaciones            PciDonacion[]
  serologiaDonaciones      SerologiaDonacion[]
  entrevista               EntrevistaPreDonacion?
  calificacionBiologica    CalificacionBiologica?
  anticuerpoIrregular      AnticuerpoIrregular?
  estadoUnidad             EstadoUnidad            @default(PENDIENTE)
  discrepanciaResuelta     Boolean                 @default(false)
  observacionDiscrepancia  String?
  tipificacionesSanguineas TipificacionSanguinea[]
  eventosEstadoUnidad      EventoEstadoUnidad[]

  @@map("donaciones")
}

model Antigeno {
  id         Int            @id @default(autoincrement())
  nombre     String         @unique
  resultados PciResultado[]

  @@map("antigenos")
}

model DeterminacionSerologica {
  id         Int                  @id @default(autoincrement())
  nombre     String               @unique
  resultados SerologiaResultado[]

  @@map("determinaciones_serologicas")
}

model Pci {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @db.Date
  hora          DateTime @db.Time
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resultados PciResultado[]
  donaciones PciDonacion[]

  @@map("pci")
}

model PciResultado {
  id          Int      @id @default(autoincrement())
  pciId       Int
  pci         Pci      @relation(fields: [pciId], references: [id])
  antigenoId  Int
  antigeno    Antigeno @relation(fields: [antigenoId], references: [id])
  resultado   String
  intensidad  String?
  observacion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([pciId, antigenoId])
  @@map("pci_resultados")
}

model PciDonacion {
  pciId      Int
  pci        Pci      @relation(fields: [pciId], references: [id])
  donacionId Int
  donacion   Donacion @relation(fields: [donacionId], references: [id])

  @@id([pciId, donacionId])
  @@map("pci_donaciones")
}

model Serologia {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @db.Date
  hora          DateTime @db.Time
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resultados SerologiaResultado[]
  donaciones SerologiaDonacion[]

  @@map("serologias")
}

model SerologiaResultado {
  id                        Int                     @id @default(autoincrement())
  serologiaId               Int
  serologia                 Serologia               @relation(fields: [serologiaId], references: [id])
  determinacionSerologicaId Int
  determinacionSerologica   DeterminacionSerologica @relation(fields: [determinacionSerologicaId], references: [id])
  resultado                 String
  valor                     String?
  unidad                    String?
  observacion               String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@unique([serologiaId, determinacionSerologicaId])
  @@map("serologia_resultados")
}

model SerologiaDonacion {
  serologiaId Int
  serologia   Serologia @relation(fields: [serologiaId], references: [id])
  donacionId  Int
  donacion    Donacion  @relation(fields: [donacionId], references: [id])

  @@id([serologiaId, donacionId])
  @@map("serologia_donaciones")
}

model EntrevistaPreDonacion {
  id                Int               @id @default(autoincrement())
  donanteId         Int
  donacionId        Int?              @unique
  resultadoAdmision ResultadoAdmision
  tipoDiferimiento  TipoDiferimiento?
  causaDiferimiento String?
  entrevistador     String?
  donante           Donante           @relation(fields: [donanteId], references: [id])
  donacion          Donacion?         @relation(fields: [donacionId], references: [id])
  respuestas        Json
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("entrevistas_pre_donacion")
}

model CalificacionBiologica {
  id          Int                         @id @default(autoincrement())
  donacionId  Int                         @unique
  donacion    Donacion                    @relation(fields: [donacionId], references: [id])
  estado      EstadoCalificacionBiologica @default(INICIADA)
  operador    String
  fechaInicio DateTime                    @default(now())
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@map("calificaciones_biologicas")
}

model AnticuerpoIrregular {
  id          Int                          @id @default(autoincrement())
  donacionId  Int                          @unique
  donacion    Donacion                     @relation(fields: [donacionId], references: [id])
  resultado   ResultadoAnticuerpoIrregular
  operador    String
  fechaHora   DateTime                     @default(now())
  observacion String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([donacionId, fechaHora])
  @@map("anticuerpos_irregulares")
}

model TipificacionSanguinea {
  id         Int               @id @default(autoincrement())
  donacionId Int
  donacion   Donacion          @relation(fields: [donacionId], references: [id])
  grupoABO   GrupoSanguineoABO
  factorRhD  FactorRhD
  operador   String
  fechaHora  DateTime          @default(now())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([donacionId, fechaHora])
  @@map("tipificaciones_sanguineas")
}

model SolicitudTransfusion {
  id                 Int                        @id @default(autoincrement())
  pacienteId         Int?
  paciente           Paciente?                  @relation(fields: [pacienteId], references: [id], onDelete: SetNull)
  dniPaciente        String
  nombrePaciente     String
  grupoABO           GrupoSanguineoABO
  factorRhD          FactorRhD
  tipoHemocomponente TipoHemocomponente
  cantidad           Int                        @default(1)
  estado             EstadoSolicitudTransfusion @default(PENDIENTE)
  observaciones      String?
  operador           String
  fechaHora          DateTime                   @default(now())
  modalidad          ModalidadTransfusion?
  lugarRealizacion   String?
  servicioSalaCama   String?
  servicioSolicitante String?
  sala               String?
  cama               String?
  piso               String?
  sector             String?
  unidadRealizacion  String?
  servicioDerivante  String?
  domicilioRealizacion String?
  localidadReferencia String?
  diagnosticoBase    String?
  diagnosticoIndicacion String?
  antecedenteTransfusional AntecedenteTransfusional?
  reaccionTransfusionalPrev AntecedenteTransfusional?
  sensibilizacionObstetrica AntecedenteTransfusional?
  hematocrito        Float?
  hemoglobina        Float?
  plaquetas          Int?
  fechaHoraLaboratorio DateTime?
  volumenMl          Int?
  irradiado          Boolean @default(false)
  lavado             Boolean @default(false)
  desleucocitado     Boolean @default(false)
  fraccionadoPediatrico Boolean @default(false)
  caracter           CaracterTransfusion?
  fechaHoraRecepcion DateTime?
  medicoPrescriptor String?
  firmaAclarada      String?
  matriculaPrescriptor String?
  aprobadaPor          String?
  fechaHoraAprobacion  DateTime?
  opinionMedica        String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  unidades UnidadSangre[]
  auditoria SolicitudTransfusionAuditoria[]
  estudiosPretransfusionales EstudioPretransfusional[]
  emisiones EmisionUnidad[]

  @@index([estado, fechaHora])
  @@index([pacienteId])
  @@map("solicitudes_transfusion")
}

model SolicitudTransfusionAuditoria {
  id            Int                 @id @default(autoincrement())
  solicitudId   Int
  solicitud     SolicitudTransfusion @relation(fields: [solicitudId], references: [id])
  accion        String
  datoModificado String
  valorAnterior String?
  valorNuevo    String?
  motivo        String?
  operador      String
  fechaHora     DateTime            @default(now())
  createdAt     DateTime            @default(now())

  @@index([solicitudId, fechaHora])
  @@map("solicitudes_transfusion_auditoria")
}

model UnidadSangre {
  id                 Int                   @id @default(autoincrement())
  numeroUnidad       String                @unique
  tipoHemocomponente TipoHemocomponente
  grupoABO           GrupoSanguineoABO
  factorRhD          FactorRhD
  fechaVencimiento   DateTime              @db.Date
  estado             EstadoUnidadSangre    @default(DISPONIBLE)
  operador           String                @default("")
  fechaRecepcion     DateTime              @default(now())
  solicitudId        Int?
  solicitud          SolicitudTransfusion? @relation(fields: [solicitudId], references: [id])
  reservadaPor       String?
  reservadaEn        DateTime?
  motivoBaja         MotivoBajaUnidad?
  operadorBaja       String?
  fechaBaja          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  estudiosPretransfusionales EstudioPretransfusional[]
  emisiones EmisionUnidad[]

  @@index([estado, fechaVencimiento])
  @@map("unidades_sangre")
}

model EventoEstadoUnidad {
  id                      Int          @id @default(autoincrement())
  donacionId              Int
  donacion                Donacion     @relation(fields: [donacionId], references: [id])
  estado                  EstadoUnidad
  motivo                  String?
  usuario                 String
  discrepanciaResuelta    Boolean      @default(false)
  observacionDiscrepancia String?
  fechaHora               DateTime     @default(now())
  createdAt               DateTime     @default(now())

  @@index([donacionId, fechaHora])
  @@map("eventos_estado_unidad")
}


model EstudioPretransfusional {
  id              Int                                      @id @default(autoincrement())

  solicitudId     Int
  solicitud       SolicitudTransfusion                     @relation(fields: [solicitudId], references: [id])

  unidadSangreId  Int?
  unidadSangre    UnidadSangre?                             @relation(fields: [unidadSangreId], references: [id])

  tipo            TipoEstudioPretransfusional
  resultado       String
  compatibilidad  ResultadoCompatibilidadPretransfusional?

  observaciones   String?
  operador        String
  fechaHora       DateTime                                 @default(now())
  createdAt       DateTime                                 @default(now())

  @@index([solicitudId, fechaHora])
  @@index([unidadSangreId])
  @@map("estudios_pretransfusionales")
}

model EmisionUnidad {
  id                      Int                                      @id @default(autoincrement())
  unidadSangreId          Int
  unidadSangre            UnidadSangre                             @relation(fields: [unidadSangreId], references: [id])
  solicitudId             Int
  solicitud               SolicitudTransfusion                     @relation(fields: [solicitudId], references: [id])
  pacienteId              Int?
  dniPaciente             String
  nombrePaciente          String
  grupoABOReceptor        GrupoSanguineoABO
  factorRhDReceptor       FactorRhD
  numeroUnidad            String
  tipoHemocomponente      TipoHemocomponente
  grupoABOUnidad          GrupoSanguineoABO
  factorRhDUnidad         FactorRhD
  fechaVencimientoUnidad  DateTime                                 @db.Date
  caracter                CaracterTransfusion?
  requisitosEspeciales    String?
  resultadoCompatibilidad ResultadoCompatibilidadPretransfusional?
  compatibilidadCompleta  Boolean
  responsable             String
  observaciones           String?
  fechaHora               DateTime                                 @default(now())
  createdAt               DateTime                                 @default(now())

  @@index([unidadSangreId, fechaHora])
  @@index([solicitudId])
  @@map("emisiones_unidad")
}
