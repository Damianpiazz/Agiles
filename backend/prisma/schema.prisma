generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SexoBiologico {
  MASCULINO
  FEMENINO
}

enum EstadoDonacion {
  REGISTRADA
  EN_CALIFICACION
  CALIFICADA
  RECHAZADA
}

enum ResultadoAdmision {
  ADMITIDO
  DIFERIDO
}

enum TipoDiferimiento {
  TEMPORAL
  PERMANENTE
}

enum EstadoCalificacionBiologica {
  INICIADA
}

enum ResultadoAnticuerpoIrregular {
  POSITIVO
  NEGATIVO
}

enum GrupoSanguineoABO {
  A
  B
  AB
  O
}

enum FactorRhD {
  POSITIVO
  NEGATIVO
}

enum EstadoUnidad {
  PENDIENTE
  LIBERADA
  BLOQUEADA
}

model Donante {
  id              Int           @id @default(autoincrement())
  nombre          String
  apellido        String
  dni             String        @unique
  fechaNacimiento DateTime      @db.Date
  lugarNacimiento String
  sexoBiologico   SexoBiologico
  domicilio       String
  codigoPostal    String
  email           String
  telefonoFijo    String?
  telefonoCelular String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  donaciones  Donacion[]
  entrevistas EntrevistaPreDonacion[]

  @@map("donantes")
}

model Donacion {
  id              Int            @id @default(autoincrement())
  donanteId       Int
  donante         Donante        @relation(fields: [donanteId], references: [id])
  fechaHora       DateTime       @default(now())
  operador        String
  estado          EstadoDonacion @default(REGISTRADA)
  peso            String?
  tensionArterial String?
  hemoglobina     String?
  voluntario      Boolean        @default(false)
  reposicion      Boolean        @default(false)
  autoExcluido    Boolean        @default(false)
  observaciones   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  pciDonaciones            PciDonacion[]
  serologiaDonaciones      SerologiaDonacion[]
  entrevista               EntrevistaPreDonacion?
  calificacionBiologica    CalificacionBiologica?
  anticuerpoIrregular      AnticuerpoIrregular?
  estadoUnidad             EstadoUnidad            @default(PENDIENTE)
  discrepanciaResuelta     Boolean                 @default(false)
  observacionDiscrepancia  String?
  tipificacionesSanguineas TipificacionSanguinea[]
  eventosEstadoUnidad      EventoEstadoUnidad[]

  @@map("donaciones")
}

model Antigeno {
  id         Int            @id @default(autoincrement())
  nombre     String         @unique
  resultados PciResultado[]

  @@map("antigenos")
}

model DeterminacionSerologica {
  id         Int                  @id @default(autoincrement())
  nombre     String               @unique
  resultados SerologiaResultado[]

  @@map("determinaciones_serologicas")
}

model Pci {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @db.Date
  hora          DateTime @db.Time
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resultados PciResultado[]
  donaciones PciDonacion[]

  @@map("pci")
}

model PciResultado {
  id          Int      @id @default(autoincrement())
  pciId       Int
  pci         Pci      @relation(fields: [pciId], references: [id])
  antigenoId  Int
  antigeno    Antigeno @relation(fields: [antigenoId], references: [id])
  resultado   String
  intensidad  String?
  observacion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([pciId, antigenoId])
  @@map("pci_resultados")
}

model PciDonacion {
  pciId      Int
  pci        Pci      @relation(fields: [pciId], references: [id])
  donacionId Int
  donacion   Donacion @relation(fields: [donacionId], references: [id])

  @@id([pciId, donacionId])
  @@map("pci_donaciones")
}

model Serologia {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @db.Date
  hora          DateTime @db.Time
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resultados SerologiaResultado[]
  donaciones SerologiaDonacion[]

  @@map("serologias")
}

model SerologiaResultado {
  id                        Int                     @id @default(autoincrement())
  serologiaId               Int
  serologia                 Serologia               @relation(fields: [serologiaId], references: [id])
  determinacionSerologicaId Int
  determinacionSerologica   DeterminacionSerologica @relation(fields: [determinacionSerologicaId], references: [id])
  resultado                 String
  valor                     String?
  unidad                    String?
  observacion               String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@unique([serologiaId, determinacionSerologicaId])
  @@map("serologia_resultados")
}

model SerologiaDonacion {
  serologiaId Int
  serologia   Serologia @relation(fields: [serologiaId], references: [id])
  donacionId  Int
  donacion    Donacion  @relation(fields: [donacionId], references: [id])

  @@id([serologiaId, donacionId])
  @@map("serologia_donaciones")
}

model EntrevistaPreDonacion {
  id                Int               @id @default(autoincrement())
  donanteId         Int
  donacionId        Int?              @unique
  resultadoAdmision ResultadoAdmision
  tipoDiferimiento  TipoDiferimiento?
  causaDiferimiento String?
  entrevistador     String?
  donante           Donante           @relation(fields: [donanteId], references: [id])
  donacion          Donacion?         @relation(fields: [donacionId], references: [id])
  respuestas        Json
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("entrevistas_pre_donacion")
}

model CalificacionBiologica {
  id          Int                         @id @default(autoincrement())
  donacionId  Int                         @unique
  donacion    Donacion                    @relation(fields: [donacionId], references: [id])
  estado      EstadoCalificacionBiologica @default(INICIADA)
  operador    String
  fechaInicio DateTime                    @default(now())
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@map("calificaciones_biologicas")
}

model AnticuerpoIrregular {
  id          Int                          @id @default(autoincrement())
  donacionId  Int                          @unique
  donacion    Donacion                     @relation(fields: [donacionId], references: [id])
  resultado   ResultadoAnticuerpoIrregular
  operador    String
  fechaHora   DateTime                     @default(now())
  observacion String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([donacionId, fechaHora])
  @@map("anticuerpos_irregulares")
}

model TipificacionSanguinea {
  id         Int               @id @default(autoincrement())
  donacionId Int
  donacion   Donacion          @relation(fields: [donacionId], references: [id])
  grupoABO   GrupoSanguineoABO
  factorRhD  FactorRhD
  operador   String
  fechaHora  DateTime          @default(now())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([donacionId, fechaHora])
  @@map("tipificaciones_sanguineas")
}

model EventoEstadoUnidad {
  id                      Int          @id @default(autoincrement())
  donacionId              Int
  donacion                Donacion     @relation(fields: [donacionId], references: [id])
  estado                  EstadoUnidad
  motivo                  String?
  usuario                 String
  discrepanciaResuelta    Boolean      @default(false)
  observacionDiscrepancia String?
  fechaHora               DateTime     @default(now())
  createdAt               DateTime     @default(now())

  @@index([donacionId, fechaHora])
  @@map("eventos_estado_unidad")
}
