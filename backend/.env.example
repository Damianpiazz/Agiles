NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=florhema_db
POSTGRES_PORT=5432

# Dentro de Docker el host es "db"; para correr el backend en el host usá "localhost".
DATABASE_URL=postgresql://postgres:tu_password_segura@db:5432/florhema_db

# Seguridad
# Si AUTH_REQUIRED=false, los endpoints de escritura funcionan sin token
# con un usuario de desarrollo (solo para desarrollo local).
AUTH_REQUIRED=false
AUTH_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
AUTH_TOKEN_TTL_HOURS=12

# Trazabilidad
AUDIT_ENABLED=true
REQUEST_LOGGING=true
